{
  "name": "@goondocks/myco-collective",
  "version": "0.3.0",
  "description": "Myco Collective worker, admin UI, and deployment CLI",
  "type": "module",
  "bin": {
    "myco-collective": "dist/main.js"
  },
  "files": [
    "dist/",
    "worker/src/",
    "worker/package.json",
    "worker/package-lock.json",
    "worker/tsconfig.json",
    "worker/wrangler.toml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/goondocks-co/myco/tree/main/packages/myco-collective",
  "bugs": {
    "url": "https://github.com/goondocks-co/myco/issues"
  },
  "keywords": [
    "myco",
    "collective",
    "cloudflare",
    "admin-ui",
    "mcp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git",
    "directory": "packages/myco-collective"
  },
  "scripts": {
    "postinstall": "test -d ui && cd ui && npm install || true",
    "build": "npm run build:core && npm run build:ui && npm run build:verify",
    "build:core": "node scripts/clean-core.mjs && tsup",
    "build:ui": "test -d ui && cd ui && npx vite build",
    "build:verify": "node -e \"require('node:fs').statSync('dist/ui/index.html')\" || (echo 'build:verify failed — dist/ui/index.html missing' >&2; exit 1)",
    "dev:ui": "test -d ui && cd ui && npx vite dev",
    "lint": "tsc --noEmit",
    "test": "echo 'myco-collective tests run from repo root'"
  }
}
