{
  "name": "@goondocks/myco-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:ui && wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.bun.json",
    "check:ui": "node ../../scripts/ensure-deps.mjs --ui && cd ui && npm run typecheck",
    "build:ui": "node ../../scripts/ensure-deps.mjs --ui && cd ui && npx vite build",
    "migrations:emit": "bun scripts/emit-migrations.ts",
    "migrations:apply": "wrangler d1 migrations apply myco-server --local",
    "migrations:apply:remote": "wrangler d1 migrations apply myco-server --remote -c wrangler.deploy.toml",
    "token:mint": "bun scripts/mint-local.ts",
    "token:revoke": "bun scripts/revoke-local.ts",
    "image:build": "docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile -t ghcr.io/goondocks-co/myco-server:${MYCO_VERSION:-dev} ../..",
    "image:build:native": "docker buildx build -f Dockerfile -t ghcr.io/goondocks-co/myco-server:${MYCO_VERSION:-dev} --load ../.."
  },
  "dependencies": {
    "@goondocks/myco-shared": "^0.2.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@stablelib/sha256": "2.0.1",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
