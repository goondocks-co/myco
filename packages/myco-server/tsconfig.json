{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@goondocks/myco-shared/relevance": ["../myco-shared/src/relevance.ts"],
      "@goondocks/myco-shared/recall": ["../myco-shared/src/recall.ts"],
      "@goondocks/myco-shared/repository": ["../myco-shared/src/repository.ts"]
    },
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "src/platform/bun/**",
    "src/entry/bun.ts"
  ]
}
