{
  "hooks": {
    "PreInvocation": [
      {
        "name": "myco-session-start",
        "command": "cd \"${ANTIGRAVITY_PROJECT_DIR:-.}\" && node .agents/myco-run.cjs hook session-start --symbiont antigravity",
        "timeout": 10000
      },
      {
        "name": "myco-user-prompt-submit",
        "command": "cd \"${ANTIGRAVITY_PROJECT_DIR:-.}\" && node .agents/myco-run.cjs hook user-prompt-submit --symbiont antigravity",
        "timeout": 5000
      }
    ],
    "PostToolUse": [
      {
        "name": "myco-post-tool-use",
        "command": "cd \"${ANTIGRAVITY_PROJECT_DIR:-.}\" && node .agents/myco-run.cjs hook post-tool-use --symbiont antigravity",
        "timeout": 5000
      }
    ],
    "PostInvocation": [
      {
        "name": "myco-post-invocation",
        "command": "cd \"${ANTIGRAVITY_PROJECT_DIR:-.}\" && node .agents/myco-run.cjs hook post-tool-use --symbiont antigravity",
        "timeout": 5000
      }
    ],
    "Stop": [
      {
        "name": "myco-stop",
        "command": "cd \"${ANTIGRAVITY_PROJECT_DIR:-.}\" && node .agents/myco-run.cjs hook stop --symbiont antigravity",
        "timeout": 30000
      }
    ]
  }
}
