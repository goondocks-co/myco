{
  "sessionStart": [
    {
      "command": "{{mycoLauncher}} hook session-start --symbiont cursor",
      "type": "command",
      "timeout": 10
    }
  ],
  "postToolUse": [
    {
      "command": "{{mycoLauncher}} hook post-tool-use --symbiont cursor",
      "type": "command",
      "timeout": 5
    }
  ],
  "postToolUseFailure": [
    {
      "command": "{{mycoLauncher}} hook post-tool-use-failure --symbiont cursor",
      "type": "command",
      "timeout": 5
    }
  ],
  "stop": [
    {
      "command": "{{mycoLauncher}} hook stop --symbiont cursor",
      "type": "command",
      "timeout": 30
    }
  ],
  "sessionEnd": [
    {
      "command": "{{mycoLauncher}} hook session-end --symbiont cursor",
      "type": "command",
      "timeout": 10
    }
  ]
}
