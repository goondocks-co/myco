{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook session-start --symbiont codex",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook user-prompt-submit --symbiont codex",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook post-tool-use --symbiont codex",
          "timeout": 5
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook subagent-start --symbiont codex",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook session-end --symbiont codex",
          "timeout": 3
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook stop --symbiont codex",
          "timeout": 30
        }
      ]
    }
  ]
}
