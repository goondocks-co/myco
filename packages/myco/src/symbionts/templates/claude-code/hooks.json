{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook session-start --symbiont claude-code",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook user-prompt-submit --symbiont claude-code",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook stop --symbiont claude-code",
          "timeout": 30
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook session-end --symbiont claude-code",
          "timeout": 10
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{mycoLauncher}} hook subagent-start --symbiont claude-code",
          "timeout": 5
        }
      ]
    }
  ]
}
