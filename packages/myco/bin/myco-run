#!/usr/bin/env node

// Self-locating MCP launcher with layered runtime-command dispatch.
//
// Two dispatch modes, checked in order:
//
//   1. Alias mode — consult the layered `runtime.command` pin (project
//      pin via walk-up from cwd, then machine pin at `~/.myco/runtime.command`).
//      If a pin is found, re-exec into that binary with the same argv.
//      Single env-var marker (MYCO_RUN_REDIRECTED=1) prevents infinite
//      recursion. If the aliased binary isn't on PATH (ENOENT), fall
//      through to self-locate.
//
//   2. Self-locate — resolve this launcher's own install via
//      realpathSync(argv[1]) and exec the sibling packaged launcher
//      (`bin/myco.cjs`).

import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { execFileSync } from 'node:child_process';
import { createRequire } from 'node:module';

const resolution = createRequire(import.meta.url)('./binary-resolution.cjs');

function isPackagedInstall(scriptPath) {
  return scriptPath.split(path.sep).includes('node_modules');
}

// G7 (security): pin files are exec'd as the user's `myco` binary, so a
// group/other-writable or foreign-owned pin would let a hostile local user
// redirect the MCP server. Refuse any such pin — matches
function resolveLayeredPin() {
  const found = resolution.readLayeredPin(process.cwd());
  return found ? { pin: found.pin, source: found.pinPath } : null;
}

function tryRedirectViaAlias(argv) {
  if (process.env.MYCO_RUN_REDIRECTED === '1') return false;
  const found = resolveLayeredPin();
  if (!found) return false;

  // A trusted `runtime.home` beside the winning command pin redirects the MCP
  // server's home so a dev-pinned project's tools reach the dev daemon. Absent
  // → leave MYCO_HOME as-is (prod default).
  const childEnv = { ...process.env, MYCO_RUN_REDIRECTED: '1' };
  const homePin = resolution.readTrustedPin(path.join(path.dirname(found.source), 'runtime.home'));
  if (homePin) childEnv.MYCO_HOME = resolution.expandHome(homePin);

  try {
    execFileSync(found.pin, argv, {
      stdio: 'inherit',
      env: childEnv,
    });
    process.exit(0);
  } catch (error) {
    if (error.code === 'ENOENT') return false;
    process.exit(error.status ?? 1);
  }
}

function resolveSelfLocatedEntry() {
  const scriptPath = fs.realpathSync(process.argv[1]);
  const installRoot = path.resolve(path.dirname(scriptPath), '..');
  const candidate = path.join(installRoot, 'bin', 'myco.cjs');
  if (fs.existsSync(candidate)) return candidate;

  throw new Error(`could not locate packaged Myco CLI under ${installRoot}`);
}

function shouldPreferGlobalFallback() {
  try {
    const scriptPath = fs.realpathSync(process.argv[1]);
    const installRoot = path.resolve(path.dirname(scriptPath), '..');
    return !isPackagedInstall(scriptPath) && fs.existsSync(path.join(installRoot, 'src'));
  } catch {
    return false;
  }
}

function tryExecGlobal(argv) {
  // Managed binary first — a GUI-launched agent's PATH need not contain
  // `myco`; the bare name is the last resort.
  const managed = resolution.managedBinaryPath(
    resolution.resolveMycoHome(), process.platform, process.env.LOCALAPPDATA,
  );
  const candidates = resolution.isRunnableBinary(managed)
    ? [managed, resolution.bareCommandName(process.platform)]
    : [resolution.bareCommandName(process.platform)];
  for (const candidate of candidates) {
    try {
      execFileSync(candidate, argv, { stdio: 'inherit' });
      process.exit(0);
    } catch (error) {
      if (error.code === 'ENOENT') continue;
      process.exit(error.status ?? 1);
    }
  }
  return false;
}

function execSelfLocated(argv) {
  let cliEntry;
  try {
    cliEntry = resolveSelfLocatedEntry();
  } catch (error) {
    process.stderr.write(`[myco-run] ${error.message}\n`);
    process.exit(1);
  }

  try {
    execFileSync(process.execPath, [cliEntry, ...argv], { stdio: 'inherit' });
  } catch (error) {
    if (error.code === 'ENOENT') process.exit(0);
    process.exit(error.status ?? 1);
  }
}

const forwardArgs = process.argv.slice(2);
tryRedirectViaAlias(forwardArgs);
if (shouldPreferGlobalFallback()) {
  tryExecGlobal(forwardArgs);
}
execSelfLocated(forwardArgs);
