{
  "name": "@goondocks/myco",
  "version": "0.21.2",
  "description": "Collective agent intelligence — Claude Code plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "myco": "dist/src/cli.js",
    "myco-run": "bin/myco-run"
  },
  "files": [
    "bin/",
    "dist/",
    "commands/",
    "skills/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "postinstall": "test -d ui && cd ui && npm install || true",
    "codegen": "tsx scripts/gen-hook-config.ts",
    "prebuild": "npm run codegen",
    "build": "npm run build:core && npm run build:ui && npm run build:verify",
    "build:core": "node scripts/clean-core.mjs && tsup",
    "build:ui": "if [ -d ui ]; then cd ui && { test -d node_modules || npm ci; } && npx vite build; fi",
    "build:verify": "node -e \"require('node:fs').statSync('dist/ui/index.html')\" || (echo 'build:verify failed — dist/ui/index.html missing' >&2; exit 1)",
    "build:watch": "tsc --watch",
    "build:types": "tsc",
    "test": "vitest run",
    "test:fast": "MYCO_TEST_PROFILE=fast vitest run",
    "test:integration": "MYCO_TEST_PROFILE=integration vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/goondocks-co/myco",
  "bugs": {
    "url": "https://github.com/goondocks-co/myco/issues"
  },
  "keywords": [
    "myco",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "team-sync",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git",
    "directory": "packages/myco"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@anthropic-ai/sdk": "^0.90.0",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@openai/agents": "^0.8.4",
    "@vscode/ripgrep": "^1.15.14",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.7.4",
    "sqlite-vec": "^0.1.8",
    "yaml": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
