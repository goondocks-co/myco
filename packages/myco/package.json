{
  "name": "@goondocks/myco",
  "version": "0.0.0-dev",
  "description": "Collective agent intelligence — Claude Code plugin",
  "type": "module",
  "scripts": {
    "codegen": "tsx scripts/gen-hook-config.ts && tsx scripts/gen-ui-assets.ts && node scripts/gen-templates.mjs && tsx scripts/gen-plugin-bundle.ts && tsx scripts/gen-worker-bundle.ts",
    "build": "npm run build:ui && npm run codegen && node scripts/clean-core.mjs && npm run build:binary && npm run build:verify",
    "build:binaries": "node scripts/clean-core.mjs && node scripts/build-all-targets.mjs",
    "build:binary": "node scripts/build-single-target.mjs",
    "build:ui": "npm run build:ui -w @goondocks/myco-server",
    "build:verify": "node scripts/verify-build.mjs",
    "test": "cd ../.. && node scripts/run-bun-tests.mjs",
    "test:debug": "cd ../.. && node scripts/run-bun-tests.mjs --bail=1 --only-failures",
    "test:fast": "cd ../.. && MYCO_TEST_PROFILE=fast node scripts/run-bun-tests.mjs",
    "test:integration": "cd ../.. && MYCO_TEST_PROFILE=integration node scripts/run-bun-tests.mjs",
    "test:watch": "cd ../.. && node scripts/run-bun-tests.mjs --watch",
    "lint:skills": "tsx scripts/lint-skill-content.ts",
    "lint:skills:strict": "tsx scripts/lint-skill-content.ts --strict",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/goondocks-co/myco",
  "bugs": {
    "url": "https://github.com/goondocks-co/myco/issues"
  },
  "keywords": [
    "myco",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "team-sync",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git",
    "directory": "packages/myco"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@anthropic-ai/sdk": "^0.135.0",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/agents": "^0.20.0",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "semver": "^7.8.4",
    "shell-quote": "^1.12.0",
    "smol-toml": "^1.9.1",
    "undici": "8.12.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@goondocks/myco-shared": "*",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "@vscode/ripgrep": "^1.15.14",
    "sqlite-vec": "^0.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-v6": "npm:typescript@^6.0.3"
  },
  "private": true
}
