{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@myco/*": ["./src/*"],
      "@myco-collective/*": ["../myco-collective/src/*"],
      "@myco-deploy/*": ["../myco-deploy/src/*"],
      "@goondocks/myco-shared": ["../myco-shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "plugin/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "ui",
    "src/worker",
    "src/symbionts/templates",
    "src/entries/cli.*.ts"
  ]
}
