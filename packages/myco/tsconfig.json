{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@myco/*": ["./src/*"],
      "@myco-server-worker/*": ["../myco-server/src/*"],
      "@goondocks/myco-shared": ["../myco-shared/src/index.ts"],
      "@goondocks/myco-shared/relevance": ["../myco-shared/src/relevance.ts"],
      "@goondocks/myco-shared/recall": ["../myco-shared/src/recall.ts"],
      "@goondocks/myco-shared/repository": ["../myco-shared/src/repository.ts"],
      "@goondocks/myco-shared/worker-usage": ["../myco-shared/src/worker-usage.ts"],
      "@goondocks/myco-shared/execution-profile": ["../myco-shared/src/execution-profile.ts"],
      "@goondocks/myco-shared/settings-contract": ["../myco-shared/src/settings-contract.ts"],
      "@goondocks/myco-shared/redact-secrets": ["../myco-shared/src/redact-secrets.ts"],
      "@goondocks/myco-shared/canopy": ["../myco-shared/src/canopy.ts"],
      "@goondocks/myco-shared/harness-providers": ["../myco-shared/src/harness-providers.ts"],
      "@goondocks/myco-shared/skills": ["../myco-shared/src/skills.generated.ts"],
      "@goondocks/myco-shared/skill-candidates": ["../myco-shared/src/skill-candidates.ts"],
      "@goondocks/myco-shared/agent-config": ["../myco-shared/src/agent-config.ts"],
      "@goondocks/myco-shared/capture-rule-schema": ["../myco-shared/src/capture-rule-schema.ts"],
      "@goondocks/myco-shared/capture-rules": ["../myco-shared/src/capture-rules.ts"],
      "@goondocks/myco-shared/capture-rules-data": ["../myco-shared/src/capture-rules.generated.ts"],
      "@goondocks/myco-shared/session-ids": ["../myco-shared/src/session-ids.ts"],
      "@goondocks/myco-shared/dot-path": ["../myco-shared/src/dot-path.ts"],
      "@goondocks/myco-shared/member-protocol": ["../myco-shared/src/member-protocol.ts"],
      "@goondocks/myco-shared/run-control": ["../myco-shared/src/run-control.ts"],
      "@goondocks/myco-shared/d1-export": ["../myco-shared/src/d1-export.ts"],
      "@goondocks/myco-shared/secret-slots": ["../myco-shared/src/secret-slots.ts"]
    }
  },
  "include": ["src/**/*", "plugin/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "ui",
    "src/symbionts/templates",
    "src/entries/cli.*.ts"
  ]
}
