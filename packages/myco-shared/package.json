{
  "name": "@goondocks/myco-shared",
  "version": "0.2.0",
  "description": "Shared internal helpers (process, port, browser, JSON) for Myco packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./relevance": {
      "import": "./dist/relevance.js",
      "types": "./dist/relevance.d.ts"
    },
    "./recall": {
      "import": "./dist/recall.js",
      "types": "./dist/recall.d.ts"
    },
    "./harness-providers": {
      "import": "./dist/harness-providers.js",
      "types": "./dist/harness-providers.d.ts"
    },
    "./run-holds": {
      "import": "./dist/run-holds.js",
      "types": "./dist/run-holds.d.ts"
    },
    "./repository": {
      "import": "./dist/repository.js",
      "types": "./dist/repository.d.ts"
    },
    "./canopy": {
      "import": "./dist/canopy.js",
      "types": "./dist/canopy.d.ts"
    },
    "./skill-candidates": {
      "import": "./dist/skill-candidates.js",
      "types": "./dist/skill-candidates.d.ts"
    },
    "./skills": {
      "import": "./dist/skills.generated.js",
      "types": "./dist/skills.generated.d.ts"
    },
    "./agent-config": {
      "import": "./dist/agent-config.js",
      "types": "./dist/agent-config.d.ts"
    },
    "./worker-usage": {
      "import": "./dist/worker-usage.js",
      "types": "./dist/worker-usage.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/goondocks-co/myco/tree/main/packages/myco-shared",
  "bugs": {
    "url": "https://github.com/goondocks-co/myco/issues"
  },
  "keywords": [
    "myco",
    "internal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git",
    "directory": "packages/myco-shared"
  },
  "scripts": {
    "build": "bun scripts/build.mjs && tsc --emitDeclarationOnly --declaration --declarationMap false --outDir dist",
    "lint": "tsc --noEmit",
    "test": "echo 'myco-shared tests run from repo root'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
