{
  "hooks": {
    "pre_user_prompt": [
      {
        "command": "node .agents/myco-run.cjs hook user-prompt-submit --symbiont windsurf"
      }
    ],
    "post_run_command": [
      {
        "command": "node .agents/myco-run.cjs hook post-tool-use --symbiont windsurf"
      }
    ],
    "post_write_code": [
      {
        "command": "node .agents/myco-run.cjs hook post-tool-use --symbiont windsurf"
      }
    ],
    "post_cascade_response": [
      {
        "command": "node .agents/myco-run.cjs hook stop --symbiont windsurf"
      }
    ]
  }
}
