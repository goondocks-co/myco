{
  "name": "@goondocks/myco-monorepo",
  "private": true,
  "version": "0.21.2",
  "description": "Myco monorepo workspace root",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @goondocks/myco && npm run build -w @goondocks/myco-team && npm run build -w @goondocks/myco-collective",
    "build:core": "npm run build:core -w @goondocks/myco",
    "build:ui": "npm run build:ui -w @goondocks/myco",
    "build:watch": "tsc --watch",
    "build:types": "tsc",
    "check:workers": "npm run check --prefix packages/myco-team/worker && npm run check --prefix packages/myco-collective/worker",
    "test": "vitest run",
    "test:fast": "MYCO_TEST_PROFILE=fast vitest run",
    "test:integration": "MYCO_TEST_PROFILE=integration vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && npm run check:workers"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@anthropic-ai/sdk": "^0.90.0",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@openai/agents": "^0.8.4",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.7.4",
    "sqlite-vec": "^0.1.8",
    "yaml": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@tanstack/react-query": "^5.99.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.0.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
