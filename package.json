{
  "name": "@goondocks/myco-monorepo",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Myco monorepo workspace root",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "hooks:install": "node scripts/install-fixture-hook.mjs",
    "check:fixtures": "node --import tsx scripts/check-fixture-redaction.ts",
    "build": "npm run build -w @goondocks/myco-shared && npm run build -w @goondocks/myco",
    "build:core": "npm run build:core -w @goondocks/myco",
    "build:ui": "npm run build:ui -w @goondocks/myco",
    "build:watch": "tsc --watch",
    "build:types": "tsc",
    "check:workers": "npm run check -w @goondocks/myco-server",
    "pretypecheck:tests": "tsx packages/myco/scripts/gen-worker-bundle.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "prelint": "tsx packages/myco/scripts/gen-worker-bundle.ts",
    "test": "node scripts/run-bun-tests.mjs",
    "test:parity": "MYCO_PARITY=1 node scripts/run-bun-tests.mjs tests/parity/parity.test.ts",
    "smoke:worker": "bun --no-env-file scripts/smoke-worker-run.ts",
    "smoke:worker-service": "bun --no-env-file scripts/smoke-worker-service.ts",
    "test:debug": "node scripts/run-bun-tests.mjs --bail=1 --only-failures",
    "test:fast": "MYCO_TEST_PROFILE=fast node scripts/run-bun-tests.mjs",
    "test:integration": "MYCO_TEST_PROFILE=integration node scripts/run-bun-tests.mjs",
    "test:watch": "node scripts/run-bun-tests.mjs --watch",
    "lint:skills": "tsx packages/myco/scripts/lint-skill-content.ts",
    "lint:skills:strict": "tsx packages/myco/scripts/lint-skill-content.ts --strict",
    "lint": "npm run lint:skills:strict && tsc --noEmit && npm run typecheck:tests && npm run check:workers && npm run check:ui -w @goondocks/myco-server",
    "test:screens": "node scripts/run-test-command.mjs npx playwright test -c tests/ui-screens/playwright.config.ts",
    "screens:shoot": "tsx tests/ui-screens/shoot.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@anthropic-ai/sdk": "^1.1.0",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/agents": "^0.20.0",
    "chokidar": "^6.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^7.34.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vscode/ripgrep": "1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "saxes": "^6.0.0",
    "sqlite-vec": "^0.1.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-v6": "npm:typescript@^6.0.3"
  }
}
