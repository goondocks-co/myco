{
  "name": "@goondocks/myco-monorepo",
  "private": true,
  "version": "0.19.2",
  "description": "Myco monorepo workspace root",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @goondocks/myco && npm run build -w @goondocks/myco-team && npm run build -w @goondocks/myco-collective",
    "build:core": "npm run build:core -w @goondocks/myco",
    "build:ui": "npm run build:ui -w @goondocks/myco",
    "build:watch": "tsc --watch",
    "build:types": "tsc",
    "test": "vitest run",
    "test:fast": "MYCO_TEST_PROFILE=fast vitest run",
    "test:integration": "MYCO_TEST_PROFILE=integration vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goondocks-co/myco.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@anthropic-ai/sdk": "^0.88.0",
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.7.4",
    "sqlite-vec": "^0.1.8",
    "yaml": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
