{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "@cloudflare/workers-types/experimental"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "packages/myco/src/**/*",
    "packages/myco-shared/src/**/*",
    "tests/**/*.ts",
    "scripts/source-install.ts",
    "scripts/smoke-member-global.ts",
    "scripts/smoke-worker-run.ts",
    "scripts/smoke-worker-service.ts"
  ],
  "files": [
    "tests/cli/import.test.ts",
    "tests/cli/login.test.ts",
    "tests/cli/cutover.test.ts",
    "tests/cli/doctor-member-mcp.test.ts",
    "tests/cli/doctor-runtime-pin.test.ts",
    "tests/cli/doctor-worker-service.test.ts",
    "tests/cli/member-machine-verbs.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/myco-server/ui",
    "packages/myco/src/symbionts/templates",
    "packages/myco/src/entries/cli.*.ts",
    "tests/myco-server-ui",
    "tests/setup/jsdom.ts",
    "tests/setup/vitest.ts",
    "tests/cli"
  ]
}
