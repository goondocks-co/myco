{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@myco/*": ["./packages/myco/src/*"],
      "@myco-team/*": ["./packages/myco-team/src/*"],
      "@myco-collective/*": ["./packages/myco-collective/src/*"],
      "@myco-deploy/*": ["./packages/myco-deploy/src/*"]
    }
  },
  "include": ["packages/myco/src/**/*", "packages/myco-team/src/**/*", "packages/myco-collective/src/**/*", "packages/myco-deploy/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "packages/myco/ui",
    "packages/myco/src/worker",
    "packages/myco/src/symbionts/templates"
  ]
}
