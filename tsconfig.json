{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@myco/*": ["./packages/myco/src/*"],
      "@myco-team/*": ["./packages/myco-team/src/*"],
      "@myco-team-worker/*": ["./packages/myco-team/worker/src/*"],
      "@myco-server-worker/*": ["./packages/myco-server/src/*"],
      "@myco-deploy/*": ["./packages/myco-deploy/src/*"],
      "@goondocks/myco-shared": ["./packages/myco-shared/src/index.ts"],
      "@goondocks/myco-shared/relevance": ["./packages/myco-shared/src/relevance.ts"],
      "@goondocks/myco-shared/recall": ["./packages/myco-shared/src/recall.ts"],
      "@goondocks/myco-shared/repository": ["./packages/myco-shared/src/repository.ts"],
      "@goondocks/myco-shared/worker-usage": ["./packages/myco-shared/src/worker-usage.ts"],
      "@goondocks/myco-shared/canopy": ["./packages/myco-shared/src/canopy.ts"],
      "@goondocks/myco-shared/skills": ["./packages/myco-shared/src/skills.generated.ts"],
      "@goondocks/myco-shared/run-holds": ["./packages/myco-shared/src/run-holds.ts"],
      "@goondocks/myco-shared/harness-providers": ["./packages/myco-shared/src/harness-providers.ts"],
      "@goondocks/myco-shared/skill-candidates": ["./packages/myco-shared/src/skill-candidates.ts"],
      "@goondocks/myco-shared/agent-config": ["./packages/myco-shared/src/agent-config.ts"],
      "@goondocks/myco-shared/capture-rule-schema": ["./packages/myco-shared/src/capture-rule-schema.ts"],
      "@goondocks/myco-shared/capture-rules": ["./packages/myco-shared/src/capture-rules.ts"],
      "@goondocks/myco-shared/capture-rules-data": ["./packages/myco-shared/src/capture-rules.generated.ts"],
      "@goondocks/myco-shared/dot-path": ["./packages/myco-shared/src/dot-path.ts"],
      "react": ["./node_modules/react"],
      "react-dom": ["./node_modules/react-dom"],
      "react/jsx-runtime": ["./node_modules/react/jsx-runtime.js"],
      "react/jsx-dev-runtime": ["./node_modules/react/jsx-dev-runtime.js"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query/build/modern/index.js"],
      "react-router-dom": ["./node_modules/react-router-dom/dist/index.mjs"],
      "react-router": ["./node_modules/react-router/dist/development/index.mjs"]
    }
  },
  "include": ["packages/myco/src/**/*", "packages/myco-team/src/**/*", "packages/myco-shared/src/**/*", "packages/myco-deploy/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "packages/myco/ui",
    "packages/myco/src/worker",
    "packages/myco/src/symbionts/templates",
    "packages/myco/src/entries/cli.*.ts"
  ]
}
